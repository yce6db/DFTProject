  override_warning_libxc             True
  xc                                 libxc MGGA_XC_B97M_V
  spin                               collinear
  charge                             0
  relativistic                       atomic_zora scalar
  atomic_solver_xc                   pbe
  ionic_solver_xc                    pbe
  
  occupation_type                    gaussian 0.2
  sc_accuracy_rho                    1e-05
  sc_accuracy_eev                    1e-03
  sc_accuracy_etot                   1e-06
  
  charge_mix_param                   0.05
  n_max_pulay 			   8
  occupation_acc 		           1e-6
  max_zeroin 			   20000
  default_initial_moment             2.0
  sc_iter_limit 10000
  
  
  ################################################################################
  #
  #  FHI-aims code project
  #  VB, Fritz-Haber Institut, 2009
  #  JOP:lightdense
  #
  #  Suggested "light" defaults for C atom (to be pasted into control.in file)
  #  Be sure to double-check any results obtained with these settings for post-processing,
  #  e.g., with the "tight" defaults and larger basis sets.
  #
  ################################################################################
    species        C
  #     global species definitions
      nucleus             6
      mass                12.0107
  #
      l_hartree           4
  #
      cut_pot             3.5  1.5  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         34 7.0
      radial_multiplier   2
      angular_grids specified
        division   0.2187   50
        division   0.4416  110
        division   0.6335  194
        division   0.7727  302
        division   0.8772  434
