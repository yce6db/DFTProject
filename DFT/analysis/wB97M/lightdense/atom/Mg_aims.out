  override_warning_libxc             True
  xc                                 libxc HYB_MGGA_XC_WB97M_V
  spin                               collinear
  charge                             0
  relativistic                       atomic_zora scalar
  atomic_solver_xc                   pbe
  ionic_solver_xc                    pbe
  
  occupation_type                    gaussian 0.0000001
  sc_accuracy_rho                    1e-05
  sc_accuracy_eev                    1e-03
  sc_accuracy_etot                   1e-06
  
  charge_mix_param                   0.1
  n_max_pulay                        8
  occupation_acc 		           1e-9
  max_zeroin 			   20000
  default_initial_moment             0.0
  
  
  ################################################################################
  #
  #  FHI-aims code project
  #  VB, Fritz-Haber Institut, 2009
  #  JOP:lightdense
  #
  #  Suggested "light" defaults for Mg atom (to be pasted into control.in file)
  #  Be sure to double-check any results obtained with these settings for post-processing,
  #  e.g., with the "tight" defaults and larger basis sets.
  #
  ################################################################################
    species        Mg
  #     global species definitions
      nucleus             12
      mass                24.3050
  #
      l_hartree           4
  #
      cut_pot             4.0          1.5  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         40 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.5421   50
        division   0.8500  110
        division   1.0736  194
        division   1.1879  302
        division   1.2806  434
