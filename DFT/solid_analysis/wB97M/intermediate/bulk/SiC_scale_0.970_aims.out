      nucleus             14
      mass                28.0855
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         42 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.4121   50
