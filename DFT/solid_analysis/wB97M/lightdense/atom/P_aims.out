  ################################################################################
    species        P
  #     global species definitions
      nucleus             15
      mass                30.973762
  #
      l_hartree           4
  #
      cut_pot             3.5          1.5  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         43 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.2995   50
        division   0.5998  110
