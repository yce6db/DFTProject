  spin                               collinear
  charge                             0
  relativistic                       atomic_zora scalar
  atomic_solver_xc                   pbe
  ionic_solver_xc                    pbe
  
  occupation_type                    gaussian 0.0000001
  sc_accuracy_rho                    1e-05
  sc_accuracy_eev                    1e-03
  sc_accuracy_etot                   1e-06
  
  charge_mix_param                   0.1
  n_max_pulay                        8
  occupation_acc 		           1e-9
  max_zeroin 			   20000
  default_initial_moment             3.0
  
  
  ################################################################################
  #
  #  FHI-aims code project
  #  VB, Fritz-Haber Institut, 2010
  #  JOP:lightdense
  #
  #  Suggested "light" defaults for P atom (to be pasted into control.in file)
