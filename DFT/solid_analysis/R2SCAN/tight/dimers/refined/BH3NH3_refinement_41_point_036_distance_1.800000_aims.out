      basis_dep_cutoff    1e-4
  #
      radial_base         32 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.3742  110
        division   0.5197  194
        division   0.5753  302
        division   0.7664  434
  #      division   0.8392  770
  #      division   1.6522  974
  #      outer_grid   974
        outer_grid  434
  ################################################################################
