       hydro 2 p 1.4
       hydro 3 d 4.8
       hydro 2 s 4
  #  "Second tier" - improvements: -33.88 meV to -2.20 meV
       hydro 4 f 7.8
       hydro 3 p 4.2
       hydro 3 s 3.3
       hydro 5 g 11.2
       hydro 3 d 5.4
  #  "Third tier" - improvements: -1.28 meV to -0.36 meV
  #     hydro 2 p 4.7
  #     hydro 2 s 8.4
