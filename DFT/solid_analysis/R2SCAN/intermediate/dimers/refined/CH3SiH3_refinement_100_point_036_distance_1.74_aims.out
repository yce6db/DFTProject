  occupation_type                    gaussian 0.01
  
  sc_accuracy_rho                    1e-06
  sc_accuracy_eev                    1e-03
  sc_accuracy_etot                   1e-06
  occupation_acc                     1e-09
  
  charge_mix_param                   0.1
