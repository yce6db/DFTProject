       hydro 2 s 2.1
       hydro 2 p 3.5
  #  "Second tier" - improvements: -12.89 meV to -1.83 meV
       hydro 1 s 0.85
  #     hydro 2 p 3.7
  #     hydro 2 s 1.2
    for_aux    hydro 3 d 7
