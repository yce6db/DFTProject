  -----------------------------------------------------------------------
  
  override_warning_libxc             True
  xc                                 hse06 0.11
  hse_unit 			   bohr-1
  
  spin                               none
  charge                             0
  
  relativistic                       atomic_zora scalar
  atomic_solver_xc                   pbe
  ionic_solver_xc                    pbe
  
  occupation_type                    gaussian 0.01
  
  sc_accuracy_rho                    1e-06
  sc_accuracy_eev                    1e-03
  sc_accuracy_etot                   1e-06
  occupation_acc                     1e-09
  
  charge_mix_param                   0.1
  n_max_pulay                        8
  max_zeroin                         20000
  
  # Species defaults for Al
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2018
  #
  #  Suggested "intermediate" defaults for Al atom (to be pasted into control.in file)
  #
  ################################################################################
    species        Al
  #     global species definitions
      nucleus             13
      mass                26.9815386
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         41 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.6594  110
        division   0.8170  194
        division   0.9059  302
        division   1.0363  434
  #      division   1.1443  590
  #      division   1.2621  770
  #      division   2.8177  974
  #      outer_grid   974
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      3  s   2.
      valence      3  p   1.
  #     ion occupancy
      ion_occ      3  s   1.
      ion_occ      2  p   6.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 2.0 A, 2.5 A, 3.0 A, 3.75 A, 4.5 A
  #
  ################################################################################
  #  "First tier" - improvements: -199.47 meV to -10.63 meV
       ionic 3 d auto
       ionic 3 p auto
       hydro 4 f 4.7
       ionic 3 s auto
  #  "Second tier" - improvements: -5.35 meV to -1.57 meV
    for_aux   hydro 5 g 7
  #     hydro 3 d 6
  #     hydro 2 s 11.6
  #     hydro 2 p 0.9
  #  "Third tier" - improvements: -0.63 meV to -0.20 meV
  #     hydro 5 f 7.6
  #     hydro 4 p 7.2
  #     hydro 4 s 3.7
  #     hydro 4 d 7.6
  #  "Fourth tier" - improvements: -0.17 meV to -0.08 meV
  #     hydro 4 d 13.6
  #     hydro 5 g 11.2
  #     hydro 4 d 0.9
  #     hydro 1 s 0.4
  #     hydro 4 p 0.1
  #     hydro 5 f 9.8
  #  Further basis functions that fell out of the optimization - noise level...
  #     hydro 4 p 5
  
  ################################################################################
  #
  # For methods that use the localized form of the "resolution of identity" for
  # the two-electron Coulomb operator (RI_method LVL), particularly Hartree-Fock and
  # hybrid density functional calculations, the highest accuracy can be obtained by
  # uncommenting the line beginning with "for_aux"  below, thus adding an extra g radial
  # function to the construction of the product basis set for the expansion.
  # See Ref. New J. Phys. 17, 093020 (2015) for more information, particularly Figs. 1 and 6.
  #
  ################################################################################
  #
  # for_aux hydro 5 g 6.0
  
  # Species defaults for P
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, Maria Dragoumi, Sebastian Kokott 2020
  #
  #  Suggested "intermediate" defaults for P atom (to be pasted into control.in file)
  #
  ################################################################################
    species        P
  #     global species definitions
      nucleus             15
      mass                30.973762
  #
      l_hartree           6
  #
      cut_pot             4.0          2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         43 7.0
      radial_multiplier   2
      angular_grids       specified
        division   0.2995   50
        division   0.5998  110
        division   0.9240  194
        division   1.0921  302
        division   1.2863  434
  #      division   1.3165  590
  #      division   1.4113  770
  #      division   1.5128  974
  #      division   2.4980 1202
        outer_grid  434
  ################################################################################
  #
  #  Definition of "minimal" basis
  #
  ################################################################################
  #     valence basis states
      valence      3  s   2.
      valence      3  p   3.
  #     ion occupancy
      ion_occ      3  s   1.
      ion_occ      3  p   2.
  ################################################################################
  #
  #  Suggested additional basis functions. For production calculations,
  #  uncomment them one after another (the most important basis functions are
  #  listed first).
  #
  #  Constructed for dimers: 1.625 A, 1.875 A, 2.5 A, 3.25 A, 4.0 A
  #
  ################################################################################
  #  "First tier" - improvements: -726.20 meV to -35.91 meV
       ionic 3 d auto
       ionic 3 p auto
       hydro 4 f 6.2
    for_aux   hydro 5 g 8.6
       ionic 3 s auto
  #  "Second tier" - improvements: -16.02 meV to -1.71 meV
  #     hydro 4 d 6.2
  #     hydro 4 p 9.2
  #     hydro 5 f 9.8
  #     hydro 1 s 0.7
  #     hydro 5 g 13.2
  #  "Third tier" - improvements: -1.82 meV to -0.20 meV
  #     hydro 3 p 2.5
  #     hydro 4 d 6.4
  #     hydro 5 f 11.2
  #     hydro 2 s 1.5
  #  "Fourth tier" - improvements: -0.91 meV to -0.17 meV
  #     hydro 3 d 16.8
  #     hydro 5 g 18
  #     hydro 4 p 4.5
  #     hydro 3 s 2.1
  #  Further basis functions that fell out of the optimization - < -0.09 meV
  #     hydro 4 p 10.4
  #     hydro 4 d 17.6
  #     hydro 4 s 11.2
  ################################################################################
  #
  # For methods that use the localized form of the "resolution of identity" for
  # the two-electron Coulomb operator (RI_method LVL), particularly Hartree-Fock and
  # hybrid density functional calculations, the highest accuracy can be obtained by
  # uncommenting the line beginning with "for_aux"  below, thus adding an extra g radial
  # function to the construction of the product basis set for the expansion.
  # See Ref. New J. Phys. 17, 093020 (2015) for more information, particularly Figs. 1 and 6.
  #
  ################################################################################
  #
  # for_aux hydro 5 g 6.0
  
